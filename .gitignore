# Local-only calibration / scenario bundles fetched from external sources.
# Tracked files (draw_samples_500.json, the v1.1.x gaspam + concentrations)
# stay committed on their feature branches; these big-bundle directories
# (FaIR Zenodo CSV bundle, Marit's CICERO RCMIP working set) are pulled
# in locally and not committed.
configurations/fair-calibrate-v*/
configurations/ciceroscm/rcmip-march2026/

# RCMIP runner output (regenerated by scripts/run_rcmip.py).
# Per-scenario CSVs are big and one-per-scenario; PNG figures are
# small and useful for PR review, so we keep them tracked.
out/rcmip/*.csv
out/rcmip/summary_*.csv

# Local scratch.
scenario_data/
